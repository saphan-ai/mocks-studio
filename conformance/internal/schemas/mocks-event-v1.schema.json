{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mocks.event/v1",
  "title": "Mocks Studio event envelope, version 1",
  "description": "Appendix A of the ADR draft 'One run, one correlation id, one event schema' (W0, train mock-studio, 2026-10-29). Normative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "at", "run_id", "correlation_id", "correlation_source", "mock", "kind", "direction", "protocol", "summary"],
  "properties": {
    "schema": { "const": "mocks.event/v1" },
    "event_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "test_run_id": { "$ref": "#/$defs/run_id" },
    "step_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_id": { "type": "string", "pattern": "^[0-9a-f]{32}$", "not": { "const": "00000000000000000000000000000000" } },
    "correlation_source": { "enum": ["traceparent", "correlation-key", "generated"] },
    "correlation_keys": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 256 }
    },
    "mock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "contract"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "contract": { "type": "string", "pattern": "^mocks\\.adapter/v[0-9]+$" }
      }
    },
    "kind": {
      "anyOf": [
        { "enum": ["request.received", "response.sent", "message.delivered", "callout.sent", "fault.injected", "scenario.set", "scope.opened", "scope.reset", "scope.closed", "scope.mismatch"] },
        { "type": "string", "pattern": "^x-[a-z0-9-]+\\.[a-z0-9.-]+$" }
      ]
    },
    "direction": { "enum": ["inbound", "outbound", "internal"] },
    "protocol": { "enum": ["http", "tcp", "smtp", "dns", "other"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
    "outcome": { "enum": ["ok", "fault", "refused"] },
    "fault": { "type": "string", "minLength": 1, "maxLength": 128 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["redacted", "digest", "size"],
          "properties": {
            "redacted": { "const": true },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["redacted", "fields"],
          "properties": {
            "redacted": { "const": false },
            "fields": { "type": "object" }
          }
        }
      ]
    }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" }
  }
}
